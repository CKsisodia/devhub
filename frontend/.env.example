# ─── DevHub frontend (Next.js) ─── copy to .env.local. Never commit .env.local.

# Where the backend API runs. Every /api/* request (incl. sign-in at /api/auth/*) is proxied there,
# so the browser only talks to this app and the httpOnly session cookie stays first-party.
# Read at build/start time (next.config.ts rewrites): set it in Vercel project settings too.
BACKEND_URL=http://localhost:4000

NEXT_PUBLIC_APP_NAME=FE Panel
