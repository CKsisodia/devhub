# ─── DevHub frontend (Next.js) ─── copy to .env.local. Never commit .env.local.

# Where the backend API runs. Every /api/* request (incl. SuperTokens /api/auth/*) is proxied there,
# so the browser only talks to this app and session cookies stay first-party.
# Read at build/start time (next.config.ts rewrites): set it in Vercel project settings too.
BACKEND_URL=http://localhost:4000

NEXT_PUBLIC_APP_NAME=FE Panel

# Shows "the code is printed in the backend console" on the OTP screen. Local dev only.
NEXT_PUBLIC_DEV_OTP_HINT=true
