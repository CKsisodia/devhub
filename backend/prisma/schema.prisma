// DevHub / FE Panel data model (see requirements v1.1, section 4)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LearningType {
  BLOG
  ARTICLE
  NEWS
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique // "admin" | "viewer"
  users User[]
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  phoneNumber       String   @unique @map("phone_number") // E.164, e.g. +919876500001
  supertokensUserId String?  @unique @map("supertokens_user_id")
  roleId            String   @map("role_id") @db.Uuid
  role              Role     @relation(fields: [roleId], references: [id])
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")

  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  createdTasks  Task[]          @relation("TaskCreatedBy")
  projects      Project[]       @relation("ProjectCreatedBy")
  learningItems LearningItem[]
  docsCreated   Doc[]           @relation("DocCreatedBy")
  docsUpdated   Doc[]           @relation("DocUpdatedBy")
  attachments   Attachment[]
  activity      ActivityLog[]

  @@map("users")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String        @default("")
  status      ProjectStatus @default(ACTIVE)
  archived    Boolean       @default(false)
  startDate   DateTime?     @map("start_date") @db.Date
  targetDate  DateTime?     @map("target_date") @db.Date
  createdById String        @map("created_by") @db.Uuid
  createdBy   User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members ProjectMember[]
  tasks   Task[]
  docs    Doc[]

  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now()) @map("added_at")

  @@id([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String       @default("")
  projectId   String       @map("project_id") @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?      @map("assignee_id") @db.Uuid
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(BACKLOG)
  dueDate     DateTime?    @map("due_date") @db.Date
  tags        String[]     @default([])
  createdById String       @map("created_by") @db.Uuid
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model LearningItem {
  id          String       @id @default(uuid()) @db.Uuid
  type        LearningType
  title       String
  url         String? // external link (or null for an internal post)
  summary     String       @default("")
  body        String? // Markdown body for internal posts
  tags        String[]     @default([])
  pinned      Boolean      @default(false)
  createdById String       @map("created_by") @db.Uuid
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("learning_items")
}

model Doc {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid // null = "General" team-wide space
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?      @map("parent_id") @db.Uuid // one level of nesting only (enforced in the API)
  parent      Doc?         @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Doc[]        @relation("DocTree")
  title       String
  content     String       @default("") // Markdown incl. ```mermaid and ```chart blocks
  position    Int          @default(0)
  createdById String       @map("created_by") @db.Uuid
  createdBy   User         @relation("DocCreatedBy", fields: [createdById], references: [id])
  updatedById String       @map("updated_by") @db.Uuid
  updatedBy   User         @relation("DocUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  attachments Attachment[]

  @@index([projectId])
  @@map("docs")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  docId        String?  @map("doc_id") @db.Uuid
  doc          Doc?     @relation(fields: [docId], references: [id], onDelete: SetNull)
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  uploadedById String   @map("uploaded_by") @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  entityType String   @map("entity_type") // task | doc | project | learning | user
  entityId   String   @map("entity_id") @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid // denormalised for dashboard "recent activity"
  action     String // created | updated | deleted
  summary    String   @default("")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([createdAt])
  @@map("activity_logs")
}
