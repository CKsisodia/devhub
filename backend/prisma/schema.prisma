// DevHub / FE Panel data model (see requirements v1.2, section 4)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum BacklogStatus {
  IN_PROGRESS
  HOLD
  DONE
  REJECT
}

enum LearningType {
  BLOG
  ARTICLE
  NEWS
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique // "admin" | "viewer"
  users User[]
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String    @unique // stored lower-case
  passwordHash       String    @map("password_hash") // argon2id
  mustChangePassword Boolean   @default(false) @map("must_change_password") // true after an admin sets a temporary password
  totpEnabled        Boolean   @default(false) @map("totp_enabled")
  totpSecretEnc      String?   @map("totp_secret_enc") // AES-256-GCM encrypted with TOTP_ENCRYPTION_KEY
  totpLastStep       Int?      @map("totp_last_step") // last accepted 30 s time-step (blocks code replay)
  roleId             String    @map("role_id") @db.Uuid
  role               Role      @relation(fields: [roleId], references: [id])
  active             Boolean   @default(true)
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  sessions      Session[]
  memberships   ProjectMember[]
  backlogItems  BacklogItem[]
  projects      Project[]       @relation("ProjectCreatedBy")
  learningItems LearningItem[]
  docsCreated   Doc[]           @relation("DocCreatedBy")
  docsUpdated   Doc[]           @relation("DocUpdatedBy")
  attachments   Attachment[]
  activity      ActivityLog[]

  @@map("users")
}

/// Server-side sessions. The browser only holds a random token in an httpOnly cookie; we store its SHA-256.
model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  tokenHash            String   @unique @map("token_hash")
  userId               String   @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerified          Boolean  @default(false) @map("mfa_verified") // false = password OK, TOTP step pending
  pendingTotpSecretEnc String?  @map("pending_totp_secret_enc") // secret shown as QR during enrolment, until confirmed
  failedTotpAttempts   Int      @default(0) @map("failed_totp_attempts")
  expiresAt            DateTime @map("expires_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String        @default("")
  status      ProjectStatus @default(ACTIVE)
  archived    Boolean       @default(false)
  startDate   DateTime?     @map("start_date") @db.Date
  targetDate  DateTime?     @map("target_date") @db.Date
  createdById String        @map("created_by") @db.Uuid
  createdBy   User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members      ProjectMember[]
  backlogItems BacklogItem[]
  docs         Doc[]

  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now()) @map("added_at")

  @@id([projectId, userId])
  @@map("project_members")
}

/// Backlog = a simple list of notes-like records (no assignee / priority / due date / board columns).
model BacklogItem {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  notes       String        @default("")
  projectId   String?       @map("project_id") @db.Uuid // optional: null = not tied to a project
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status      BacklogStatus @default(IN_PROGRESS)
  createdById String        @map("created_by") @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@map("backlog_items")
}

model LearningItem {
  id          String       @id @default(uuid()) @db.Uuid
  type        LearningType
  title       String
  url         String? // external link (or null for an internal post)
  summary     String       @default("")
  body        String? // Markdown body for internal posts
  tags        String[]     @default([])
  pinned      Boolean      @default(false)
  createdById String       @map("created_by") @db.Uuid
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("learning_items")
}

model Doc {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid // null = "General" team-wide space
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?      @map("parent_id") @db.Uuid // one level of nesting only (enforced in the API)
  parent      Doc?         @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Doc[]        @relation("DocTree")
  title       String
  content     String       @default("") // Markdown incl. ```mermaid and ```chart blocks
  position    Int          @default(0)
  createdById String       @map("created_by") @db.Uuid
  createdBy   User         @relation("DocCreatedBy", fields: [createdById], references: [id])
  updatedById String       @map("updated_by") @db.Uuid
  updatedBy   User         @relation("DocUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  attachments Attachment[]

  @@index([projectId])
  @@map("docs")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  docId        String?  @map("doc_id") @db.Uuid
  doc          Doc?     @relation(fields: [docId], references: [id], onDelete: SetNull)
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  uploadedById String   @map("uploaded_by") @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  entityType String   @map("entity_type") // backlog | doc | project | learning | user
  entityId   String   @map("entity_id") @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid // denormalised for dashboard "recent activity"
  action     String // created | updated | deleted
  summary    String   @default("")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([createdAt])
  @@map("activity_logs")
}
