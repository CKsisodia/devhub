# ─── DevHub backend (API) ─── copy to .env and adjust. Never commit .env.

# Port the API listens on. The frontend proxies /api/* here (see frontend BACKEND_URL).
PORT=4000
NODE_ENV=development
# With NODE_ENV=production the API refuses to start unless DATABASE_URL, TOTP_ENCRYPTION_KEY and an https
# WEBSITE_DOMAIN are set; it also trusts exactly one proxy hop (Render), sends Secure cookies and HSTS.

# Postgres. Local default matches docker-compose.yml. For Neon/Supabase paste their connection string
# (add ?sslmode=require). If you use a pooled URL, run migrations with the direct (non-pooled) URL.
DATABASE_URL=postgresql://devhub:devhub@localhost:5432/devhub

# Public origin of the frontend (FRONTEND_ORIGIN is accepted as an alias). Must be https:// in production.
# Public origin of the frontend. The frontend proxies /api/* to this service, so the session cookie is
# first-party. Mutating requests whose Origin isn't this (or CORS_ORIGINS) are rejected.
WEBSITE_DOMAIN=http://localhost:3000
# Optional extra origins allowed to call this API directly with CORS (comma separated).
CORS_ORIGINS=
APP_NAME=FE Panel

# ─── Sign-in: email + password, then a TOTP code from an authenticator app ───
# 32-byte key that encrypts TOTP secrets at rest (AES-256-GCM). REQUIRED in production; keep it secret and
# stable (changing it invalidates everyone's authenticator; they'd need an admin "Reset 2FA").
# Generate: openssl rand -base64 32
# Leave empty for local development: a built-in, clearly insecure DEV key is used (logged at startup).
TOTP_ENCRYPTION_KEY=
# Name shown in the authenticator app (defaults to APP_NAME).
TOTP_ISSUER=
# Session lifetime after a full sign-in (hours), and time allowed to finish the TOTP step (minutes).
SESSION_TTL_HOURS=168
PENDING_LOGIN_TTL_MINUTES=10
# Secure cookie flag (HTTPS only). Defaults to true when NODE_ENV=production; leave empty locally.
COOKIE_SECURE=
# Wrong-password attempts allowed per email (x4 per IP) within the window, before 429.
LOGIN_MAX_ATTEMPTS=8
RATE_LIMIT_WINDOW_MINUTES=15

# ─── AI entry from a prompt for Tasks, Roadmap, R&D and POC (any OpenAI-compatible chat completions API) ───
# Recommended (free tier, ~1 s per draft): Groq. Create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_your_key_here
# Alternatives (env-only switch):
#   Ollama (local, keyless): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY=  (LLM_TIMEOUT_MS=150000)
#   OpenRouter:              LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=qwen/qwen-2.5-7b-instruct:free  LLM_API_KEY=sk-or-...
# Per-draft timeout (ms). Hosted APIs need a few seconds; CPU-only local models 60–150 s.
LLM_TIMEOUT_MS=30000
# Max existing items of the section sent as context.
LLM_CONTEXT_ITEMS=60
# Dev only: when no LLM is configured (no key and a non-local LLM_BASE_URL), use a deterministic
# keyword-based mock (labelled "Mock AI" in the UI). Always ignored when NODE_ENV=production.
LLM_MOCK=false

# ─── Wireframe / image uploads ───
# Vercel Blob read-write token for a PRIVATE Blob store (files are only served to signed-in users via
# /api/uploads/files/...). When empty, files are stored on local disk in UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
