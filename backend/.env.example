# ─── DevHub backend (API) ─── copy to .env and adjust. Never commit .env.

# Port the API listens on. The frontend proxies /api/* here (see frontend BACKEND_URL).
PORT=4000
NODE_ENV=development

# Postgres. Local default matches docker-compose.yml. For Neon/Supabase paste their connection string
# (add ?sslmode=require). If you use a pooled URL, run migrations with the direct (non-pooled) URL.
DATABASE_URL=postgresql://devhub:devhub@localhost:5432/devhub

# Public origin of the frontend, and the origin the browser uses to reach the API.
# Both are the frontend URL because the frontend proxies /api/* to this service.
WEBSITE_DOMAIN=http://localhost:3000
API_DOMAIN=http://localhost:3000
# Optional extra origins allowed to call this API directly with CORS (comma separated).
CORS_ORIGINS=

# ─── SuperTokens (passwordless phone OTP) ───
# Self-hosted core from docker-compose (default), or the public demo core: https://try.supertokens.com
# For production use SuperTokens' managed core (connection URI + API key from their dashboard).
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
APP_NAME=FE Panel
# Default country for numbers typed without a country code (ISO 3166 alpha-2).
DEFAULT_PHONE_COUNTRY=IN

# SMS delivery: console | twilio | supertokens
#   console     -> the OTP is printed in this terminal (local development, no SMS sent)
#   twilio      -> needs TWILIO_* below
#   supertokens -> SuperTokens SMS service, needs SUPERTOKENS_SMS_API_KEY
# Note: SMS to Indian numbers usually needs DLT sender/template registration.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SUPERTOKENS_SMS_API_KEY=

# ─── AI prompt-based task entry (any OpenAI-compatible chat completions API) ───
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Dev only: when LLM_API_KEY is empty, use a deterministic keyword-based mock (clearly labelled
# "Mock AI" in the UI). Ignored when NODE_ENV=production. Set false to see the "not configured" error.
LLM_MOCK=true

# ─── Wireframe / image uploads ───
# Vercel Blob read-write token. When empty, files are stored on local disk in UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
